<!doctype html>
<html lang="ko" data-theme="corporate">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>이벤트 로그 · notibot</title>
  <%- include('partials/styles') %>
</head>
<body class="bg-base-200 min-h-screen">
  <%- include('partials/nav', { active: 'events' }) %>
  <main class="max-w-5xl mx-auto p-4 sm:p-6">
    <h2 class="text-lg font-extrabold mb-4">이벤트 로그</h2>
    <%- include('partials/error') %>

    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body p-4 sm:p-6">
        <form class="flex flex-wrap items-end gap-3 mb-2" method="get" action="/admin/events">
          <label class="flex flex-col gap-1 form-control w-full max-w-[220px]">
            <div class="label"><span class="label-text text-xs">계정</span></div>
            <select name="accountId" class="select select-bordered select-sm">
              <option value="">전체</option>
              <% accounts.forEach(function(acc) { %>
                <option value="<%= acc.id %>" <%= filters.accountId === acc.id ? 'selected' : '' %>>
                  <%= acc.username || acc.igUserId %>
                </option>
              <% }) %>
            </select>
          </label>
          <label class="flex flex-col gap-1 form-control w-full max-w-[180px]">
            <div class="label"><span class="label-text text-xs">상태</span></div>
            <select name="dmStatus" class="select select-bordered select-sm">
              <option value="">전체</option>
              <% ['SENT', 'FAILED', 'NO_MATCH', 'SKIPPED'].forEach(function(s) { %>
                <option value="<%= s %>" <%= filters.dmStatus === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn btn-primary btn-sm">필터 적용</button>
          <a href="/admin/events" class="btn btn-ghost btn-sm">초기화</a>
        </form>

        <% if (events.length === 0) { %>
          <div class="text-center text-base-content/50 py-10">아직 기록된 이벤트가 없습니다.</div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>시간</th>
                  <th>계정</th>
                  <th>미디어</th>
                  <th>댓글</th>
                  <th>작성자</th>
                  <th>매칭 키워드</th>
                  <th>상태</th>
                  <th>비고</th>
                </tr>
              </thead>
              <tbody>
                <% events.forEach(function(e) { %>
                  <tr>
                    <td class="mono text-xs text-base-content/60 whitespace-nowrap"><%= e.createdAt.toISOString().replace('T', ' ').slice(0, 19) %></td>
                    <td><%= e.account.username || e.account.igUserId %></td>
                    <td class="mono text-xs"><%= e.mediaId %></td>
                    <td class="max-w-xs truncate"><%= e.text %></td>
                    <td class="text-base-content/60"><%= e.fromUsername || e.fromUserId || '-' %></td>
                    <td><%= e.matchedRule ? e.matchedRule.keyword : '-' %></td>
                    <td>
                      <% var badgeClass = { SENT: 'badge-success', FAILED: 'badge-error', NO_MATCH: 'badge-neutral', SKIPPED: 'badge-warning' }[e.dmStatus]; %>
                      <span class="badge <%= badgeClass %> badge-sm"><%= e.dmStatus %></span>
                    </td>
                    <td class="text-base-content/60 text-xs"><%= e.errorMessage || '' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
