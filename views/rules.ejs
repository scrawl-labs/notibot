<!doctype html>
<html lang="ko" data-theme="corporate">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>트리거 규칙 · notibot</title>
  <%- include('partials/styles') %>
</head>
<body class="bg-base-200 min-h-screen">
  <%- include('partials/nav', { active: 'rules' }) %>
  <main class="max-w-5xl mx-auto p-4 sm:p-6">
    <h2 class="text-lg font-extrabold mb-4">트리거 규칙</h2>
    <%- include('partials/error') %>

    <div class="card bg-base-100 shadow-sm border border-base-300 mb-5">
      <div class="card-body p-4 sm:p-6">
        <% if (accounts.length === 0 || templates.length === 0) { %>
          <p class="text-base-content/60 text-sm">규칙을 만들려면 먼저 <a href="/admin/accounts" class="link link-primary">계정</a>과 <a href="/admin/templates" class="link link-primary">DM 템플릿</a>을 하나 이상 등록하세요.</p>
        <% } else { %>
          <form method="post" action="/admin/rules">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-3">
              <label class="flex flex-col gap-1 form-control">
                <div class="label"><span class="label-text text-xs">계정</span></div>
                <select name="accountId" required class="select select-bordered select-sm">
                  <% accounts.forEach(function(acc) { %>
                    <option value="<%= acc.id %>"><%= acc.username || acc.igUserId %></option>
                  <% }) %>
                </select>
              </label>
              <label class="flex flex-col gap-1 form-control">
                <div class="label"><span class="label-text text-xs">미디어 ID (선택)</span></div>
                <input type="text" name="mediaId" placeholder="media-123" class="input input-bordered input-sm" />
              </label>
              <label class="flex flex-col gap-1 form-control">
                <div class="label"><span class="label-text text-xs">키워드</span></div>
                <input type="text" name="keyword" required placeholder="오이" class="input input-bordered input-sm" />
              </label>
              <label class="flex flex-col gap-1 form-control">
                <div class="label"><span class="label-text text-xs">매칭 방식</span></div>
                <select name="matchType" class="select select-bordered select-sm">
                  <option value="CONTAINS">CONTAINS</option>
                  <option value="EXACT">EXACT</option>
                  <option value="REGEX">REGEX</option>
                </select>
              </label>
              <label class="flex flex-col gap-1 form-control">
                <div class="label"><span class="label-text text-xs">DM 템플릿</span></div>
                <select name="dmTemplateId" required class="select select-bordered select-sm">
                  <% templates.forEach(function(t) { %>
                    <option value="<%= t.id %>"><%= t.name %></option>
                  <% }) %>
                </select>
              </label>
              <label class="flex flex-col gap-1 form-control">
                <div class="label"><span class="label-text text-xs">우선순위</span></div>
                <input type="text" name="priority" value="0" class="input input-bordered input-sm" />
              </label>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">규칙 추가</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body p-4 sm:p-6">
        <% if (rules.length === 0) { %>
          <div class="text-center text-base-content/50 py-10">등록된 트리거 규칙이 없습니다.</div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>계정</th>
                  <th>범위</th>
                  <th>키워드</th>
                  <th>방식</th>
                  <th>템플릿</th>
                  <th>우선순위</th>
                  <th>상태</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% rules.forEach(function(r) { %>
                  <tr>
                    <td><%= r.account.username || r.account.igUserId %></td>
                    <td class="mono text-xs text-base-content/60"><%= r.mediaId || '전체' %></td>
                    <td><%= r.keyword %></td>
                    <td class="text-base-content/60"><%= r.matchType %></td>
                    <td><%= r.dmTemplate.name %></td>
                    <td class="text-base-content/60"><%= r.priority %></td>
                    <td>
                      <span class="badge badge-sm <%= r.isActive ? 'badge-success' : 'badge-neutral' %>">
                        <%= r.isActive ? '활성' : '비활성' %>
                      </span>
                    </td>
                    <td class="whitespace-nowrap">
                      <form class="inline-block" method="post" action="/admin/rules/<%= r.id %>/toggle">
                        <button type="submit" class="btn btn-ghost btn-xs"><%= r.isActive ? '비활성화' : '활성화' %></button>
                      </form>
                      <form class="inline-block" method="post" action="/admin/rules/<%= r.id %>/delete" onsubmit="return confirm('삭제할까요?');">
                        <button type="submit" class="btn btn-ghost btn-xs text-error">삭제</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
