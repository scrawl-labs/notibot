<!doctype html>
<html lang="ko" data-theme="corporate">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>계정 · notibot</title>
  <%- include('partials/styles') %>
</head>
<body class="bg-base-200 min-h-screen">
  <%- include('partials/nav', { active: 'accounts' }) %>
  <main class="max-w-5xl mx-auto p-4 sm:p-6">
    <h2 class="text-lg font-extrabold mb-4">인스타그램 계정</h2>
    <%- include('partials/error') %>

    <div class="card bg-base-100 shadow-sm border border-base-300 mb-5">
      <div class="card-body p-4 sm:p-6">
        <form method="post" action="/admin/accounts">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
            <label class="flex flex-col gap-1 form-control">
              <div class="label"><span class="label-text text-xs">Instagram User ID</span></div>
              <input type="text" name="igUserId" required placeholder="179xxxxxxxxxxxx" class="input input-bordered input-sm" />
            </label>
            <label class="flex flex-col gap-1 form-control">
              <div class="label"><span class="label-text text-xs">이름 (표시용)</span></div>
              <input type="text" name="username" placeholder="my_shop" class="input input-bordered input-sm" />
            </label>
            <label class="flex flex-col gap-1 form-control">
              <div class="label"><span class="label-text text-xs">Page Access Token</span></div>
              <input type="text" name="pageAccessToken" required placeholder="Meta에서 발급받은 토큰" class="input input-bordered input-sm" />
            </label>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">계정 추가</button>
        </form>
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body p-4 sm:p-6">
        <% if (accounts.length === 0) { %>
          <div class="text-center text-base-content/50 py-10">등록된 계정이 없습니다.</div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>IG User ID</th>
                  <th>이름</th>
                  <th>등록일</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% accounts.forEach(function(acc) { %>
                  <tr>
                    <td class="mono text-xs"><%= acc.igUserId %></td>
                    <td class="font-medium"><%= acc.username || '-' %></td>
                    <td class="mono text-xs text-base-content/60"><%= acc.createdAt.toISOString().slice(0, 10) %></td>
                    <td>
                      <form method="post" action="/admin/accounts/<%= acc.id %>/delete" onsubmit="return confirm('삭제할까요? 연결된 트리거 규칙도 함께 삭제됩니다.');">
                        <button type="submit" class="btn btn-ghost btn-xs text-error">삭제</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
